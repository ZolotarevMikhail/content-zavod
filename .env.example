# Скопируй этот файл в файл .env и вставь свои значения. .env в гит не попадает.

# Токен бота от @BotFather (создаёшь бота, он даёт строку вида 123456:ABC-...)
BOT_TOKEN=УКАЖИ_ТОКЕН_БОТА

# Твой chat_id в Telegram (куда бот присылает идеи и черновики).
# Узнать: напиши боту @userinfobot любое сообщение — он ответит твоим id.
ADMIN_CHAT_ID=УКАЖИ_СВОЙ_CHAT_ID

# Токен ВК с правом wall (создать: vk.com/dev → Implicit Flow, scope=wall,photos)
VK_TOKEN=УКАЖИ_ТОКЕН_ВК

# Куда публиковать — указывается НЕ здесь, а в config.json, раздел «соцсети»:
#   соцсети.telegram.канал_id — @имя_канала или id вида -1001234567890
#   соцсети.vk.группа_id — id группы ВК с минусом, например -12345678